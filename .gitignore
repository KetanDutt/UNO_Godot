# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg
# export_presets.cfg is committed: it makes builds reproducible and contains
# no secrets (script_encryption_key is empty).

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Local logs and temporary exports
*.log
tmp/
temp/

# Exported builds. The web export lives on the WebBuild branch / GitHub Pages;
# committing binaries to the source branch made the repo 22 MB and the artifacts
# were always stale relative to the scripts beside them.
build/
export/
*.pck
*.wasm
